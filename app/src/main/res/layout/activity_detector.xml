<?xml version="1.0" encoding="utf-8"?>
<!-- ark-ui: ark family, moderate depth. 近黑舞台 + 信号青仪表。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A0B">

    <!-- Header: 编辑式标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="单向好友"
                android:textColor="#EDEFF1"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:lineSpacingExtra="-4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELETED FRIEND DETECTOR"
                android:textColor="#18D1FF"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.14"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 1px 信号规线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#18D1FF"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Stats strip: 3 方形数据格 -->
    <LinearLayout
        android:id="@+id/statsStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp" />

    <!-- Status line -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8D9396"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:textIsSelectable="true" />

    <!-- Account selector (ArkSelector injected programmatically) -->
    <FrameLayout
        android:id="@+id/accountContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Actions row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#14181A"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌕"
            android:textColor="#5A6063"
            android:textSize="18sp"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="搜索 QQ 号 / 昵称"
            android:textColorHint="#5A6063"
            android:textColor="#EDEFF1"
            android:textSize="13sp"
            android:background="@android:color/transparent"
            android:singleLine="true" />
    </LinearLayout>

    <!-- History header: section title + 规线 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="被删记录"
            android:textColor="#EDEFF1"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/histCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8D9396"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginStart="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#2A2F33"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无被删记录\n点击「立即刷新」建立基线"
        android:textColor="#8D9396"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
